{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/auto-fix.sh",
            "timeout": 120000
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx vitest *)"
    ]
  }
}
