{
  "compilerOptions": {
    "target": "ES2022",
    
    // Đưa về lại CommonJS để tương thích 100% với code hiện tại của bạn
    "module": "CommonJS",
    
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules", 
    "dist", 
    "src/__tests__",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}