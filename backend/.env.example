# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas for production)
MONGODB_URI=mongodb://localhost:27017/tera-story

# Security (Required: min 32 chars)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
ENCRYPTION_KEY=change-me-to-a-random-string-of-at-least-32-characters

# Cloudinary (required in production so AI-generated images are persisted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional integrations
SENTRY_DSN=
LOG_LEVEL=info
